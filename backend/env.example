# Copy this file to ".env" (same folder) and fill in your Azure AI Speech details.
# Azure portal > Create a resource > "Speech" > Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ---- Accounts (optional while developing; required for a public launch) -------------------
# Leave SUPABASE_URL empty to run with one local test learner, as before.
# Supabase dashboard > Project Settings > API > Project URL
SUPABASE_URL=
# Only if your project still uses the old "JWT Secret" (Settings > API > JWT Settings). Newer projects: leave empty.
SUPABASE_JWT_SECRET=
# Optional, server only, NEVER put it in the app: lets "Delete my account" also remove the login itself.
SUPABASE_SERVICE_KEY=
# Any long random text. It makes the anonymous research IDs impossible to reverse. Do not change it later.
LANGOGO_PSEUDONYM_SALT=
# Set to 0 at launch so the leaderboard shows only real learners.
LANGOGO_DEMO_LEADERBOARD=1
# Where the backend and the web app live once deployed (used for share links and CORS).
# LANGOGO_PUBLIC_URL=https://api.yourdomain.com
# LANGOGO_APP_URL=https://yourdomain.com
# LANGOGO_CORS_ORIGINS=https://yourdomain.com

# Private page that lists every learner: http://localhost:8000/admin/users?key=<this value>
# Leave empty to switch the page off. Use a long random text.
LANGOGO_ADMIN_KEY=
