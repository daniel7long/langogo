  "dialogue": [
    {
      "speaker": "店主",
      "role": "npc",
      "text": "いらっしゃい。何にしますか。",
      "glosses": [],
      "id": "t1",
      "en": "Welcome. What will you have?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "トマトを一キロと、りんごを半キロください。",
      "glosses": [
        {
          "text": "キロ",
          "pos": "n.",
          "meaning": "kilo"
        }
      ],
      "id": "t2",
      "en": "One kilo of tomatoes and half a kilo of apples, please."
    },
    {
      "speaker": "店主",
      "role": "npc",
      "text": "今日はりんごがおいしくて安いですよ。",
      "glosses": [
        {
          "text": "安い",
          "pos": "adj.",
          "meaning": "cheap"
        }
      ],
      "id": "t3",
      "en": "The apples are tasty and cheap today."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "いいですね。スープ用の野菜もください。",
      "glosses": [
        {
          "text": "野菜",
          "pos": "n.",
          "meaning": "vegetables"
        }
      ],
      "id": "t4",
      "en": "Good. Please give me vegetables for soup too."
    },
    {
      "speaker": "店主",
      "role": "npc",
      "text": "はい、どうぞ。袋は要りますか。",
      "glosses": [],
      "id": "t5",
      "en": "Here you are. Do you need a bag?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "はい、袋をください。全部でいくらですか。",
      "glosses": [],
      "id": "t6",
      "en": "Yes, a bag please. How much is it in total?"
