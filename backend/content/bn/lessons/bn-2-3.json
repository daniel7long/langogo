  "dialogue": [
    {
      "id": "t1",
      "speaker": "Dokandar",
      "role": "npc",
      "text": "আসুন! সবজি একদম তাজা। কী লাগবে?",
      "glosses": [
        {
          "text": "সবজি",
          "pos": "n.",
          "meaning": "vegetable"
        },
        {
          "text": "তাজা",
          "pos": "adj.",
          "meaning": "fresh"
        }
      ],
      "en": "Come! The vegetables are very fresh. What do you need?"
    },
    {
      "id": "t2",
      "speaker": "You",
      "role": "you",
      "text": "আমার এক কেজি টমেটো লাগবে। দাম কত?",
      "glosses": [
        {
          "text": "দাম",
          "pos": "n.",
          "meaning": "price"
        },
        {
          "text": "কেজি",
          "pos": "n.",
          "meaning": "kilogram"
        }
      ],
      "en": "I need one kilo of tomatoes. What is the price?"
    },
    {
      "id": "t3",
      "speaker": "Dokandar",
      "role": "npc",
      "text": "চল্লিশ টাকা কেজি।",
      "glosses": [
        {
          "text": "কেজি",
          "pos": "n.",
          "meaning": "kilogram"
        }
      ],
      "en": "Forty taka a kilo."
    },
    {
      "id": "t4",
      "speaker": "You",
      "role": "you",
      "text": "এটা তো অনেক দামি। একটু সস্তা হবে?",
      "glosses": [
        {
          "text": "দামি",
          "pos": "adj.",
          "meaning": "expensive"
        },
        {
          "text": "সস্তা",
          "pos": "adj.",
          "meaning": "cheap"
        }
      ],
      "en": "This is very expensive. Can it be a bit cheaper?"
    },
    {
      "id": "t5",
      "speaker": "Dokandar",
      "role": "npc",
      "text": "ত্রিশ টাকায় দেব। ব্যাগ আছে?",
      "glosses": [
        {
          "text": "ব্যাগ",
          "pos": "n.",
          "meaning": "bag"
        }
      ],
      "en": "I'll give it for thirty. Do you have a bag?"
    },
    {
      "id": "t6",
      "speaker": "You",
      "role": "you",
      "text": "হ্যাঁ, আমার ব্যাগ এই যে। ধন্যবাদ!",
      "glosses": [
        {
          "text": "ব্যাগ",
          "pos": "n.",
          "meaning": "bag"
        }
      ],
      "en": "Yes, here is my bag. Thank you!"
    }
