  "dialogue": [
    {
      "id": "t1",
      "speaker": "Penjual",
      "role": "npc",
      "text": "Selamat datang di pasar! Sayur di sini segar. Mau beli apa?",
      "glosses": [
        {
          "text": "pasar",
          "pos": "n.",
          "meaning": "market"
        },
        {
          "text": "Sayur",
          "pos": "n.",
          "meaning": "vegetables"
        }
      ],
      "en": "Welcome to the market! The vegetables here are fresh. What do you want to buy?"
    },
    {
      "id": "t2",
      "speaker": "You",
      "role": "you",
      "text": "Saya mau satu kilo tomat. Berapa harga satu kilo?",
      "glosses": [
        {
          "text": "harga",
          "pos": "n.",
          "meaning": "price"
        },
        {
          "text": "kilo",
          "pos": "n.",
          "meaning": "kilogram"
        }
      ],
      "en": "I want one kilo of tomatoes. How much is one kilo?"
    },
    {
      "id": "t3",
      "speaker": "Penjual",
      "role": "npc",
      "text": "Lima belas ribu per kilo.",
      "glosses": [
        {
          "text": "kilo",
          "pos": "n.",
          "meaning": "kilogram"
        }
      ],
      "en": "Fifteen thousand a kilo."
    },
    {
      "id": "t4",
      "speaker": "You",
      "role": "you",
      "text": "Wah, mahal sekali. Bisa lebih murah?",
      "glosses": [
        {
          "text": "mahal",
          "pos": "adj.",
          "meaning": "expensive"
        },
        {
          "text": "murah",
          "pos": "adj.",
          "meaning": "cheap"
        }
      ],
      "en": "Wow, very expensive. Can it be cheaper?"
    },
    {
      "id": "t5",
      "speaker": "Penjual",
      "role": "npc",
      "text": "Dua belas ribu saja. Bawa tas?",
      "glosses": [
        {
          "text": "tas",
          "pos": "n.",
          "meaning": "bag"
        }
      ],
      "en": "Just twelve thousand. Do you have a bag?"
    },
    {
      "id": "t6",
      "speaker": "You",
      "role": "you",
      "text": "Ya, ini tas saya. Terima kasih!",
