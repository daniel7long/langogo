      "word": "होना",
      "ipa": "honā · /hoːnaː/",
      "pos": "v.",
      "meaning": "to be (origin)",
      "tense": "'से' + to be",
      "forms": [
        {
          "p": "मैं",
          "f": "… से हूँ",
          "ipa": "seː huː̃"
        },
        {
          "p": "तुम",
          "f": "… से हो",
          "ipa": "seː hoː"
        },
        {
          "p": "वह",
          "f": "… से है",
          "ipa": "seː hɛː"
        },
        {
          "p": "हम",
          "f": "… से हैं",
          "ipa": "seː hɛ̃ː"
        },
        {
          "p": "आप",
          "f": "… से हैं",
          "ipa": "seː hɛ̃ː"
        }
      ],
      "examples": [
        {
          "target": "मैं अमेरिका से हूँ।",
          "en": "I am from America."
        },
        {
          "target": "आप किस देश से हैं?",
          "en": "Which country are you from?"
        }
      ],
      "note": "Place + से + होना tells where you are from."
    },
