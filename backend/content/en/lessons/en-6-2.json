      "speaker": "Friend",
      "role": "npc",
      "text": "Did you see the new movie last night?",
      "glosses": [
        {
          "text": "movie",
          "pos": "n.",
          "meaning": "a story shown on a screen"
        }
      ],
      "en": "Did you watch the new movie yesterday evening?"
    },
    {
      "id": "t2",
      "speaker": "You",
      "role": "you",
      "text": "Yes, I did. The plot was exciting, and the characters were funny.",
      "glosses": [
        {
          "text": "plot",
          "pos": "n.",
          "meaning": "the events of a story"
        }
      ],
      "en": "Yes. The story was exciting, and the people in it were funny."
    },
    {
      "id": "t3",
      "speaker": "Friend",
      "role": "npc",
      "text": "Was the ending good? I hate sad endings.",
      "glosses": [
        {
          "text": "ending",
          "pos": "n.",
          "meaning": "the last part of a story"
        }
      ],
      "en": "Was the last part good? I do not like sad last parts."
    },
    {
      "id": "t4",
      "speaker": "You",
      "role": "you",
      "text": "The ending was happy. I recommend it.",
      "glosses": [
        {
          "text": "ending",
          "pos": "n.",
          "meaning": "the last part of a story"
        },
        {
          "text": "recommend",
          "pos": "v.",
          "meaning": "to say that something is good"
        }
      ],
      "en": "The last part was happy. I say you should see it."
    },
