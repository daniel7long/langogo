  "dialogue": [
    {
      "id": "t1",
      "speaker": "Friend",
      "role": "npc",
      "text": "What is your opinion about working four days a week?",
      "glosses": [
        {
          "text": "opinion",
          "pos": "n.",
          "meaning": "what you think about something"
        }
      ],
      "en": "What do you think about working four days each week?"
    },
    {
      "id": "t2",
      "speaker": "You",
      "role": "you",
      "text": "I agree with it. I believe people are happier.",
      "glosses": [
        {
          "text": "agree",
          "pos": "v.",
          "meaning": "to have the same idea as someone"
        },
        {
          "text": "believe",
          "pos": "v.",
          "meaning": "to think something is true"
        }
      ],
      "en": "I think it is good. I think people feel happier."
    },
    {
      "id": "t3",
      "speaker": "Friend",
      "role": "npc",
      "text": "That is one reason. Do you have another one?",
      "glosses": [
        {
          "text": "reason",
          "pos": "n.",
          "meaning": "why something happens or is true"
        }
      ],
      "en": "That is one cause. Is there another?"
    },
    {
      "id": "t4",
      "speaker": "You",
      "role": "you",
      "text": "Yes. For example, people have more time for family.",
      "glosses": [
        {
          "text": "example",
          "pos": "n.",
          "meaning": "something that shows what you mean"
        }
      ],
      "en": "Yes. For one, people have more time with their family."
    },
    {
      "id": "t5",
      "speaker": "Friend",
      "role": "npc",
      "text": "I disagree a little. Maybe some jobs need five days.",
      "glosses": [
        {
          "text": "disagree",
          "pos": "v.",
          "meaning": "to have a different idea"
        },
        {
          "text": "Maybe",
          "pos": "adv.",
          "meaning": "possibly"
        }
      ],
      "en": "I do not fully think so. Possibly some jobs need five days."
    },
    {
      "id": "t6",
      "speaker": "You",
      "role": "you",
      "text": "That is true. Maybe we can find a good middle.",
      "glosses": [
        {
          "text": "Maybe",
          "pos": "adv.",
          "meaning": "possibly"
        }
      ],
      "en": "That is right. Possibly we can find a good balance."
    }
  ],
