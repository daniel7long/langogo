  "dialogue": [
    {
      "id": "t1",
      "speaker": "Agent",
      "role": "npc",
      "text": "Good afternoon. May I see your passport, please?",
      "glosses": [
        {
          "text": "passport",
          "pos": "n.",
          "meaning": "a small book that shows who you are when you travel"
        }
      ],
      "en": "Hello. Can you show me your passport?"
    },
    {
      "id": "t2",
      "speaker": "You",
      "role": "you",
      "text": "Here you are. I would like to check in for my flight.",
      "glosses": [
        {
          "text": "flight",
          "pos": "n.",
          "meaning": "a trip in a plane"
        },
        {
          "text": "check in",
          "pos": "phr. v.",
          "meaning": "to tell the airline you have arrived"
        }
      ],
      "en": "This is it. I want to tell you I have arrived for my flight."
    },
    {
      "id": "t3",
      "speaker": "Agent",
      "role": "npc",
      "text": "Thank you. Do you have any luggage?",
      "glosses": [
        {
          "text": "luggage",
          "pos": "n.",
          "meaning": "the bags you take on a trip"
        }
      ],
      "en": "Thanks. Do you have bags?"
    },
    {
      "id": "t4",
      "speaker": "You",
      "role": "you",
      "text": "Yes, one bag. Is my flight on time?",
      "glosses": [
        {
          "text": "flight",
          "pos": "n.",
          "meaning": "a trip in a plane"
        }
      ],
      "en": "Yes, one bag. Is my plane on time?"
    },
    {
      "id": "t5",
      "speaker": "Agent",
      "role": "npc",
      "text": "It is delayed by thirty minutes. Boarding is at gate twelve.",
      "glosses": [
        {
          "text": "gate",
          "pos": "n.",
          "meaning": "the place where you get on a plane"
        },
        {
          "text": "delayed",
          "pos": "adj.",
          "meaning": "later than planned"
        },
        {
          "text": "Boarding",
          "pos": "n.",
          "meaning": "the time when people get on the plane"
        }
      ],
      "en": "It is 30 minutes late. You get on at gate 12."
    },
    {
      "id": "t6",
      "speaker": "You",
      "role": "you",
      "text": "Thank you. I will wait at the gate.",
      "glosses": [
        {
          "text": "gate",
          "pos": "n.",
          "meaning": "the place where you get on a plane"
        }
      ],
      "en": "Thanks. I will wait by the gate."
