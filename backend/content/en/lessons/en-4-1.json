    },
    {
      "id": "t2",
      "speaker": "You",
      "role": "you",
      "text": "It is near here. Go straight for two blocks.",
      "glosses": [
        {
          "text": "straight",
          "pos": "adv.",
          "meaning": "in a line, without turning"
        },
        {
          "text": "near",
          "pos": "adj.",
          "meaning": "not far away"
        }
      ],
      "en": "It is not far. Walk ahead for two blocks."
    },
    {
      "id": "t3",
      "speaker": "Passerby",
      "role": "npc",
      "text": "Then turn left at the corner.",
      "glosses": [
        {
          "text": "turn left",
          "pos": "phr.",
          "meaning": "to change direction toward the left side"
        },
        {
          "text": "corner",
          "pos": "n.",
          "meaning": "the place where two streets meet"
        }
      ],
      "en": "After that, turn toward the left at the corner."
    },
    {
      "id": "t4",
      "speaker": "You",
      "role": "you",
      "text": "Is it far from there?",
      "glosses": [
        {
          "text": "far",
          "pos": "adj.",
          "meaning": "a long way away"
        }
      ],
      "en": "Is it a long way after that?"
