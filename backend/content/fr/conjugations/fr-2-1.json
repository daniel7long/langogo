      "id": "c1",
      "word": "se réveiller",
      "ipa": "/sə ʁe.ve.je/",
      "pos": "v.",
      "meaning": "to wake up",
      "tense": "Present (reflexive)",
      "forms": [
        {
          "p": "je",
          "f": "me réveille",
          "ipa": "/ʒə mə ʁe.vɛj/"
        },
        {
          "p": "tu",
          "f": "te réveilles",
          "ipa": "/ty tə ʁe.vɛj/"
        },
        {
          "p": "il / elle",
          "f": "se réveille",
          "ipa": "/il sə ʁe.vɛj/"
        },
        {
          "p": "nous",
          "f": "nous réveillons",
          "ipa": "/nu ʁe.vɛ.jɔ̃/"
        },
        {
          "p": "vous",
          "f": "vous réveillez",
          "ipa": "/vu ʁe.vɛ.je/"
        },
        {
          "p": "ils / elles",
          "f": "se réveillent",
          "ipa": "/il sə ʁe.vɛj/"
        }
      ],
      "examples": [
        {
          "target": "Je me réveille à sept heures.",
          "en": "I wake up at seven."
        },
        {
          "target": "Tu te réveilles tôt ?",
          "en": "Do you wake up early?"
        }
      ],
      "note": "The small pronoun (me, te, se…) comes before the verb."
    },
