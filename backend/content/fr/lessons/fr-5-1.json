    {
      "speaker": "Marc",
      "role": "npc",
      "text": "N'oublie pas de mettre de bonnes chaussures !",
      "glosses": [
        {
          "text": "chaussures",
          "pos": "f. n. pl.",
          "meaning": "shoes"
        }
      ],
      "id": "t5",
      "en": "Don't forget to wear good shoes!"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Bien sûr, à samedi !",
