  "dialogue": [
    {
      "speaker": "Marc",
      "role": "npc",
      "text": "On fait une randonnée samedi ?",
      "glosses": [
        {
          "text": "randonnée",
          "pos": "f. n.",
          "meaning": "hike"
        }
      ],
      "id": "t1",
      "en": "Shall we go hiking on Saturday?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Bonne idée ! Où est-ce qu'on va ?",
      "glosses": [],
      "id": "t2",
      "en": "Good idea! Where shall we go?"
    },
    {
      "speaker": "Marc",
      "role": "npc",
      "text": "Dans la montagne. On suit le sentier jusqu'au lac.",
      "glosses": [
        {
          "text": "montagne",
          "pos": "f. n.",
          "meaning": "mountain"
        },
        {
          "text": "sentier",
          "pos": "m. n.",
          "meaning": "trail"
        }
      ],
      "id": "t3",
      "en": "Into the mountains. We follow the trail up to the lake."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Parfait. J'apporte mon sac à dos et la carte.",
      "glosses": [
        {
          "text": "sac à dos",
          "pos": "m. n.",
          "meaning": "backpack"
        },
        {
          "text": "Parfait",
          "pos": "adj.",
          "meaning": "perfect"
        }
      ],
      "id": "t4",
      "en": "Perfect. I'll bring my backpack and the map."
