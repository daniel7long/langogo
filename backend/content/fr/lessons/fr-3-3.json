  "dialogue": [
    {
      "speaker": "Vendeur",
      "role": "npc",
      "text": "Bonjour ! Qu'est-ce que je vous donne aujourd'hui ?",
      "glosses": [],
      "id": "t1",
      "en": "Hello! What can I get you today?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Bonjour ! Je voudrais un kilo de tomates, s'il vous plaît.",
      "glosses": [
        {
          "text": "kilo",
          "pos": "m. n.",
          "meaning": "kilo"
        },
        {
          "text": "tomates",
          "pos": "f. n. pl.",
          "meaning": "tomatoes"
        }
      ],
      "id": "t2",
      "en": "Hello! I'd like a kilo of tomatoes, please."
    },
    {
      "speaker": "Vendeur",
      "role": "npc",
      "text": "Voilà. Et avec ça ? Les pommes sont très bonnes.",
      "glosses": [
        {
          "text": "pommes",
          "pos": "f. n. pl.",
          "meaning": "apples"
        }
      ],
      "id": "t3",
      "en": "Here you go. Anything else? The apples are very good."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Alors, un kilo de pommes aussi. Vous avez du lait ?",
      "glosses": [
        {
          "text": "lait",
          "pos": "m. n.",
          "meaning": "milk"
        }
      ],
      "id": "t4",
      "en": "Then a kilo of apples too. Do you have milk?"
    },
    {
      "speaker": "Vendeur",
      "role": "npc",
      "text": "Désolé, pas de lait au marché. Mais voici des légumes frais.",
      "glosses": [
        {
          "text": "marché",
          "pos": "m. n.",
          "meaning": "market"
        },
        {
          "text": "légumes",
          "pos": "m. n. pl.",
          "meaning": "vegetables"
        }
      ],
      "id": "t5",
      "en": "Sorry, no milk at the market. But here are some fresh vegetables."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Parfait, je prends tout. Vous avez un sac ?",
      "glosses": [
        {
          "text": "sac",
          "pos": "m. n.",
          "meaning": "bag"
        }
      ],
      "id": "t6",
      "en": "Perfect, I'll take everything. Do you have a bag?"
