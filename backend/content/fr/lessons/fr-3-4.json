          "text": "poisson",
          "pos": "m. n.",
          "meaning": "fish"
        },
        {
          "text": "riz",
          "pos": "m. n.",
          "meaning": "rice"
        }
      ],
      "id": "t3",
      "en": "I prefer fish with rice."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Tu manges de la viande aussi ?",
