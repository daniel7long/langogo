  "dialogue": [
    {
      "speaker": "Julie",
      "role": "npc",
      "text": "Tu te réveilles tôt ce matin ?",
      "glosses": [
        {
          "text": "tôt",
          "pos": "adv.",
          "meaning": "early"
        }
      ],
      "id": "t1",
      "en": "Are you waking up early this morning?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Oui, je me réveille à sept heures. Et toi ?",
      "glosses": [
        {
          "text": "réveille",
          "pos": "v.",
          "meaning": "wake up"
        }
      ],
      "id": "t2",
      "en": "Yes, I wake up at seven. And you?"
    },
    {
      "speaker": "Julie",
      "role": "npc",
      "text": "Moi aussi. Tu prends le petit-déjeuner ?",
      "glosses": [
        {
          "text": "petit-déjeuner",
          "pos": "m. n.",
          "meaning": "breakfast"
        }
      ],
      "id": "t3",
      "en": "Me too. Are you having breakfast?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Oui, un café et du pain. Puis je prends une douche.",
      "glosses": [
        {
          "text": "café",
          "pos": "m. n.",
          "meaning": "coffee"
        },
        {
          "text": "prends une douche",
          "pos": "v. phr.",
          "meaning": "take a shower"
        }
      ],
      "id": "t4",
      "en": "Yes, a coffee and some bread. Then I take a shower."
    },
    {
      "speaker": "Julie",
      "role": "npc",
      "text": "Et après, tu pars à quelle heure ?",
      "glosses": [
        {
          "text": "pars",
          "pos": "v.",
          "meaning": "leave"
        }
      ],
      "id": "t5",
      "en": "And after that, what time do you leave?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Je m'habille et je pars à huit heures.",
      "glosses": [
        {
          "text": "m'habille",
          "pos": "v.",
          "meaning": "get dressed"
        }
