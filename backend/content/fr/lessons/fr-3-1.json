  "dialogue": [
    {
      "speaker": "Serveur",
      "role": "npc",
      "text": "Bonjour ! Voici la carte.",
      "glosses": [
        {
          "text": "la carte",
          "pos": "f. n.",
          "meaning": "menu"
        }
      ],
      "id": "t1",
      "en": "Hello! Here is the menu."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Merci. Je voudrais un thé, s'il vous plaît.",
      "glosses": [
        {
          "text": "Je voudrais",
          "pos": "phr.",
          "meaning": "I would like"
        },
        {
          "text": "thé",
          "pos": "m. n.",
          "meaning": "tea"
        }
      ],
      "id": "t2",
      "en": "Thank you. I'd like a tea, please."
    },
    {
      "speaker": "Serveur",
      "role": "npc",
      "text": "Avec du sucre ?",
      "glosses": [
        {
          "text": "sucre",
          "pos": "m. n.",
          "meaning": "sugar"
        }
      ],
      "id": "t3",
      "en": "With sugar?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Non, merci. Et un chocolat chaud pour mon ami.",
      "glosses": [
        {
          "text": "chocolat chaud",
          "pos": "m. n.",
          "meaning": "hot chocolate"
        }
      ],
      "id": "t4",
      "en": "No, thank you. And a hot chocolate for my friend."
    },
    {
      "speaker": "Serveur",
      "role": "npc",
      "text": "Très bien. Je vous apporte ça tout de suite.",
      "glosses": [
        {
          "text": "tout de suite",
          "pos": "adv. phr.",
          "meaning": "right away"
        }
      ],
      "id": "t5",
      "en": "Very well. I'll bring that right away."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Merci ! L'addition, s'il vous plaît.",
      "glosses": [
        {
          "text": "L'addition",
          "pos": "f. n.",
          "meaning": "the bill"
        }
      ],
      "id": "t6",
      "en": "Thank you! The bill, please."
