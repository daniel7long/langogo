  "dialogue": [
    {
      "speaker": "Inès",
      "role": "npc",
      "text": "On prend le métro pour aller au musée ?",
      "glosses": [
        {
          "text": "métro",
          "pos": "m. n.",
          "meaning": "metro"
        }
      ],
      "id": "t1",
      "en": "Shall we take the metro to the museum?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Oui ! Il faut un ticket. Où est le distributeur ?",
      "glosses": [
        {
          "text": "ticket",
          "pos": "m. n.",
          "meaning": "ticket"
        }
      ],
      "id": "t2",
      "en": "Yes! We need a ticket. Where is the machine?"
    },
    {
      "speaker": "Inès",
      "role": "npc",
      "text": "Là-bas. Ensuite, prenons la ligne 1, direction La Défense.",
      "glosses": [
        {
          "text": "ligne",
          "pos": "f. n.",
          "meaning": "line"
        },
        {
          "text": "direction",
          "pos": "f. n.",
          "meaning": "direction"
        }
      ],
      "id": "t3",
      "en": "Over there. Then let's take line 1, towards La Défense."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Et on doit changer ?",
      "glosses": [
        {
          "text": "changer",
          "pos": "v.",
          "meaning": "change"
        }
      ],
      "id": "t4",
      "en": "And do we have to change?"
    },
    {
      "speaker": "Inès",
      "role": "npc",
      "text": "Non, c'est direct. On descend à la station Concorde.",
      "glosses": [
        {
          "text": "descend",
          "pos": "v.",
          "meaning": "get off"
        },
        {
          "text": "station",
          "pos": "f. n.",
          "meaning": "station"
        }
      ],
      "id": "t5",
      "en": "No, it's direct. We get off at Concorde station."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Parfait, c'est facile !",
      "glosses": [
        {
          "text": "facile",
          "pos": "adj.",
          "meaning": "easy"
        }
      ],
      "id": "t6",
      "en": "Perfect, that's easy!"
    }
  ],
