  "dialogue": [
    {
      "speaker": "Réceptionniste",
      "role": "npc",
      "text": "Bonjour, bienvenue à l'hôtel Le Soleil !",
      "glosses": [
        {
          "text": "l'hôtel",
          "pos": "m. n.",
          "meaning": "hotel"
        }
      ],
      "id": "t1",
      "en": "Hello, welcome to the Hotel Le Soleil!"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Bonjour. J'ai une réservation au nom de Martin.",
      "glosses": [
        {
          "text": "réservation",
          "pos": "f. n.",
          "meaning": "booking"
        }
      ],
      "id": "t2",
      "en": "Hello. I have a reservation under the name Martin."
    },
    {
      "speaker": "Réceptionniste",
      "role": "npc",
      "text": "Oui, une chambre double pour trois nuits. Votre passeport, s'il vous plaît ?",
      "glosses": [
        {
          "text": "chambre double",
          "pos": "f. n.",
          "meaning": "double room"
        },
        {
          "text": "nuits",
          "pos": "f. n. pl.",
          "meaning": "nights"
        },
        {
          "text": "passeport",
          "pos": "m. n.",
          "meaning": "passport"
        }
      ],
      "id": "t3",
      "en": "Yes, a double room for three nights. Your passport, please?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Voici mon passeport. Quel est le prix du petit-déjeuner ?",
      "glosses": [
        {
          "text": "prix",
          "pos": "m. n.",
          "meaning": "price"
        }
      ],
      "id": "t4",
      "en": "Here is my passport. How much is breakfast?"
    },
    {
      "speaker": "Réceptionniste",
      "role": "npc",
      "text": "Il est compris dans le prix de la chambre.",
      "glosses": [
        {
          "text": "compris",
          "pos": "adj.",
          "meaning": "included"
        }
      ],
      "id": "t5",
      "en": "It's included in the price of the room."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Super, merci ! La chambre est disponible dès maintenant ?",
      "glosses": [
        {
          "text": "disponible",
          "pos": "adj.",
          "meaning": "available"
        }
      ],
      "id": "t6",
      "en": "Great, thank you! Is the room available right now?"
    }
