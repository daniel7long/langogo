  "dialogue": [
    {
      "speaker": "Pablo",
      "role": "npc",
      "text": "Perdón, ¿qué hora es?",
      "glosses": [
        {
          "text": "qué hora es",
          "pos": "phr.",
          "meaning": "what time is it?"
        }
      ],
      "id": "t1",
      "en": "Excuse me, what time is it?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Son las diez y media.",
      "glosses": [
        {
          "text": "Son las",
          "pos": "phr.",
          "meaning": "it is (time)"
        },
        {
          "text": "y media",
          "pos": "phr.",
          "meaning": "half past"
        }
      ],
      "id": "t2",
      "en": "It is half past ten."
    },
    {
      "speaker": "Pablo",
      "role": "npc",
      "text": "¡Qué tarde! La reunión es a las once en punto.",
      "glosses": [
        {
          "text": "en punto",
          "pos": "phr.",
          "meaning": "on the dot"
        },
        {
          "text": "La reunión",
          "pos": "n.",
          "meaning": "the meeting"
        },
        {
          "text": "tarde",
          "pos": "adv.",
          "meaning": "late"
        }
      ],
      "id": "t3",
      "en": "So late! The meeting is at eleven sharp."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Tranquila, todavía tienes media hora.",
      "glosses": [],
      "id": "t4",
      "en": "Relax, you still have half an hour."
    },
    {
      "speaker": "Pablo",
      "role": "npc",
      "text": "Gracias. ¿A qué hora termina la reunión?",
      "glosses": [
        {
          "text": "la reunión",
          "pos": "n.",
          "meaning": "the meeting"
        }
      ],
      "id": "t5",
      "en": "Thanks. What time does the meeting end?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Termina a las doce. Luego comemos juntos.",
      "glosses": [],
      "id": "t6",
      "en": "It ends at twelve. Then we eat together."
    }
  ],
