      "speaker": "Vendedor",
      "role": "npc",
      "text": "Las manzanas están muy buenas y baratas hoy.",
      "glosses": [],
      "id": "t3",
      "en": "The apples are very good and cheap today."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Perfecto. También quiero verdura para la sopa.",
