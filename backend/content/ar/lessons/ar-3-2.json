    {
      "speaker": "You",
      "role": "you",
      "text": "نعم، حجزت طاولة لشخصين باسم يوسف.",
      "glosses": [
        {
          "text": "حجز",
          "pos": "m. n.",
          "meaning": "booking, reservation"
        }
      ],
      "id": "t2",
      "en": "Yes, I booked a table for two under the name Yusuf."
    },
    {
      "speaker": "Waiter",
      "role": "npc",
      "text": "تفضلوا من هنا. هذه قائمة الطعام.",
