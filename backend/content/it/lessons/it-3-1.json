  "dialogue": [
    {
      "speaker": "Cameriere",
      "role": "npc",
      "text": "Buongiorno! Cosa prende?",
      "glosses": [],
      "id": "t1",
      "en": "Good morning! What will you have?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Un cappuccino e un cornetto, per favore.",
      "glosses": [
        {
          "text": "cappuccino",
          "pos": "m. n.",
          "meaning": "cappuccino"
        }
      ],
      "id": "t2",
      "en": "A cappuccino and a croissant, please."
    },
    {
      "speaker": "Cameriere",
      "role": "npc",
      "text": "Subito. Lo vuole con lo zucchero?",
      "glosses": [
        {
          "text": "lo zucchero",
          "pos": "m. n.",
          "meaning": "sugar"
        }
      ],
      "id": "t3",
      "en": "Right away. Would you like it with sugar?"
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "No, senza zucchero. C'è un tavolo vicino alla finestra?",
      "glosses": [
        {
          "text": "zucchero",
          "pos": "m. n.",
          "meaning": "sugar"
        },
        {
          "text": "tavolo",
          "pos": "m. n.",
          "meaning": "table"
        },
        {
          "text": "la finestra",
          "pos": "f. n.",
          "meaning": "window"
        }
      ],
      "id": "t4",
      "en": "No, without sugar. Is there a table by the window?"
    },
    {
      "speaker": "Cameriere",
      "role": "npc",
      "text": "Sì, si accomodi pure.",
      "glosses": [],
      "id": "t5",
      "en": "Yes, please make yourself comfortable."
    },
    {
      "speaker": "You",
      "role": "you",
      "text": "Grazie mille. Più tardi vorrei il conto.",
      "glosses": [
        {
          "text": "il conto",
          "pos": "m. n.",
          "meaning": "bill"
        }
      ],
      "id": "t6",
      "en": "Thank you very much. Later I'd like the bill."
    }
  ],
